# Optional. docker-compose has the same defaults, so the app runs without a .env file.
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Seat hold time in seconds (default 600 = 10 minutes)
HOLD_DURATION_SECONDS=600

# Admin login (only admins can add classes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN_SECRET=dev-only-secret-change-me-before-real-use
# true = adding a class needs an admin login on the API too. false = the API endpoint stays open.
ADMIN_AUTH_REQUIRED=true

# Backend URL as seen from the browser
API_URL=http://localhost:8080

# Load size for the concurrency test (docker compose run --rm api-tests)
CONCURRENCY_REQUESTS=200
